<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Currency Converter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            min-height: 100vh;
            padding: 20px;
            /* Prevent selection on mobile to make it feel like an app */
            -webkit-user-select: none;
            user-select: none;
        }
        .container {
            max-width: 500px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 40px 30px;
            margin-top: 20px;
        }
        .header { text-align: center; margin-bottom: 30px; }
        .title { font-size: 2.2rem; color: #1976d2; font-weight: 700; margin-bottom: 10px; }
        .description { color: #666; font-size: 1rem; line-height: 1.5; }
        .converter-form { display: flex; flex-direction: column; gap: 20px; }
        .input-group { display: flex; flex-direction: column; gap: 8px; }
        .label { font-weight: 600; color: #333; font-size: 0.95rem; }
        .input-field, .select-field {
            padding: 15px 20px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #fafafa;
            width: 100%;
        }
        .input-field:focus, .select-field:focus {
            outline: none;
            border-color: #1976d2;
            background: white;
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);
        }
        .currency-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .convert-btn {
            background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
            color: white;
            border: none;
            padding: 18px 30px;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
        }
        .convert-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(25, 118, 210, 0.3); }
        .convert-btn:active { transform: translateY(0); }
        .convert-btn:disabled { background: #ccc; cursor: not-allowed; transform: none; box-shadow: none; }
        .result-area {
            margin-top: 25px;
            padding: 20px;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 12px;
            text-align: center;
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .result-text { font-size: 1.3rem; color: #333; font-weight: 600; }
        .loading { color: #1976d2; font-style: italic; }
        .error { color: #d32f2f; font-size: 0.95rem; }
        .exchange-info { margin-top: 15px; text-align: center; font-size: 0.85rem; color: #666; }
        .swap-btn {
            background: #f5f5f5;
            border: 2px solid #e0e0e0;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 10px auto;
            font-size: 1.2rem;
        }
        .swap-btn:hover { background: #1976d2; color: white; border-color: #1976d2; transform: rotate(180deg); }
        
        @media (max-width: 600px) {
            .container { margin: 10px auto; padding: 30px 20px; border-radius: 0; min-height: 100vh; }
            .title { font-size: 1.8rem; }
            .currency-row { grid-template-columns: 1fr; gap: 15px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1 class="title">Currency Converter</h1>
            <p class="description">Convert currencies in real-time.</p>
        </div>
        <form class="converter-form" id="converterForm">
            <div class="input-group">
                <label class="label" for="amount">Amount</label>
                <input class="input-field" id="amount" min="0" placeholder="Enter amount" required step="0.01" type="number" />
            </div>
            <div class="currency-row">
                <div class="input-group">
                    <label class="label" for="fromCurrency">From</label>
                    <select class="select-field" id="fromCurrency" required>
                        <option value="USD">USD - US Dollar</option>
                        <option value="EUR">EUR - Euro</option>
                        <option value="GBP">GBP - British Pound</option>
                        <option value="PKR">PKR - Pakistani Rupee</option>
                        <option value="INR">INR - Indian Rupee</option>
                        <option value="JPY">JPY - Japanese Yen</option>
                        <option value="CAD">CAD - Canadian Dollar</option>
                        <option value="AUD">AUD - Australian Dollar</option>
                        <option value="CHF">CHF - Swiss Franc</option>
                        <option value="CNY">CNY - Chinese Yuan</option>
                    </select>
                </div>
                <div class="input-group">
                    <label class="label" for="toCurrency">To</label>
                    <select class="select-field" id="toCurrency" required>
                        <option value="EUR">EUR - Euro</option>
                        <option value="USD">USD - US Dollar</option>
                        <option value="GBP">GBP - British Pound</option>
                        <option value="PKR">PKR - Pakistani Rupee</option>
                        <option value="INR">INR - Indian Rupee</option>
                        <option value="JPY">JPY - Japanese Yen</option>
                        <option value="CAD">CAD - Canadian Dollar</option>
                        <option value="AUD">AUD - Australian Dollar</option>
                        <option value="CHF">CHF - Swiss Franc</option>
                        <option value="CNY">CNY - Chinese Yuan</option>
                    </select>
                </div>
            </div>
            <div class="swap-btn" id="swapBtn" title="Swap currencies">⇅</div>
            <button class="convert-btn" id="convertBtn" type="submit">Convert Currency</button>
        </form>
        <div class="result-area" id="resultArea">
            <div class="result-text">Enter amount to convert</div>
        </div>
        <div class="exchange-info" id="exchangeInfo"></div>
    </div>

    <script>
        const fallbackRates = {
            USD: { EUR: 0.85, GBP: 0.73, PKR: 278.50, INR: 83.25, JPY: 110.15, CAD: 1.25, AUD: 1.35, CHF: 0.88, CNY: 6.45 },
            EUR: { USD: 1.18, GBP: 0.86, PKR: 327.85, INR: 98.12, JPY: 129.78, CAD: 1.47, AUD: 1.59, CHF: 1.04, CNY: 7.60 },
            GBP: { USD: 1.37, EUR: 1.16, PKR: 381.45, INR: 114.05, JPY: 150.91, CAD: 1.71, AUD: 1.85, CHF: 1.21, CNY: 8.84 },
            PKR: { USD: 0.0036, EUR: 0.0030, GBP: 0.0026, INR: 0.30, JPY: 0.40, CAD: 0.0045, AUD: 0.0049, CHF: 0.0032, CNY: 0.023 },
            INR: { USD: 0.012, EUR: 0.010, GBP: 0.0088, PKR: 3.35, JPY: 1.32, CAD: 0.015, AUD: 0.016, CHF: 0.011, CNY: 0.077 },
            JPY: { USD: 0.0091, EUR: 0.0077, GBP: 0.0066, PKR: 2.53, INR: 0.76, CAD: 0.011, AUD: 0.012, CHF: 0.0080, CNY: 0.059 },
            CAD: { USD: 0.80, EUR: 0.68, GBP: 0.58, PKR: 222.80, INR: 66.60, JPY: 88.12, AUD: 1.08, CHF: 0.70, CNY: 5.16 },
            AUD: { USD: 0.74, EUR: 0.63, GBP: 0.54, PKR: 206.30, INR: 61.69, JPY: 81.59, CAD: 0.93, CHF: 0.65, CNY: 4.78 },
            CHF: { USD: 1.14, EUR: 0.96, GBP: 0.83, PKR: 317.49, INR: 94.89, JPY: 125.19, CAD: 1.43, AUD: 1.54, CNY: 7.35 },
            CNY: { USD: 0.15, EUR: 0.13, GBP: 0.11, PKR: 43.19, INR: 12.91, JPY: 17.07, CAD: 0.19, AUD: 0.21, CHF: 0.14 }
        };

        const form = document.getElementById('converterForm');
        const amountInput = document.getElementById('amount');
        const fromCurrency = document.getElementById('fromCurrency');
        const toCurrency = document.getElementById('toCurrency');
        const convertBtn = document.getElementById('convertBtn');
        const resultArea = document.getElementById('resultArea');
        const exchangeInfo = document.getElementById('exchangeInfo');
        const swapBtn = document.getElementById('swapBtn');

        swapBtn.addEventListener('click', () => {
            const fromValue = fromCurrency.value;
            const toValue = toCurrency.value;
            fromCurrency.value = toValue;
            toCurrency.value = fromValue;
            if (amountInput.value > 0) convertCurrency();
        });

        amountInput.addEventListener('input', () => { if (amountInput.value > 0) convertCurrency(); });
        fromCurrency.addEventListener('change', () => { if (amountInput.value > 0) convertCurrency(); });
        toCurrency.addEventListener('change', () => { if (amountInput.value > 0) convertCurrency(); });

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            convertCurrency();
        });

        async function getExchangeRate(from, to) {
            if (from === to) return 1;
            try {
                const response = await fetch(`https://api.exchangerate-api.com/v4/latest/${from}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.rates && data.rates[to]) return data.rates[to];
                }
            } catch (error) { console.log('API unavailable, using fallback rates'); }
            if (fallbackRates[from] && fallbackRates[from][to]) return fallbackRates[from][to];
            if (fallbackRates[to] && fallbackRates[to][from]) return 1 / fallbackRates[to][from];
            throw new Error('Exchange rate not available');
        }

        async function convertCurrency() {
            const amount = parseFloat(amountInput.value);
            const from = fromCurrency.value;
            const to = toCurrency.value;

            if (!amount || amount <= 0) {
                resultArea.innerHTML = '<div class="result-text">Please enter a valid amount</div>';
                exchangeInfo.textContent = '';
                return;
            }

            resultArea.innerHTML = '<div class="result-text loading">Converting...</div>';
            convertBtn.disabled = true;

            try {
                const rate = await getExchangeRate(from, to);
                const convertedAmount = (amount * rate).toFixed(2);
                const formattedAmount = parseFloat(amount).toLocaleString();
                const formattedConverted = parseFloat(convertedAmount).toLocaleString();
                
                resultArea.innerHTML = `<div class="result-text">${formattedAmount} ${from} = ${formattedConverted} ${to}</div>`;
                exchangeInfo.textContent = `Exchange Rate: 1 ${from} = ${rate.toFixed(4)} ${to}`;
            } catch (error) {
                resultArea.innerHTML = '<div class="result-text error">Unable to convert.</div>';
            } finally {
                convertBtn.disabled = false;
            }
        }
    </script>
</body>
</html>
